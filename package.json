{
  "name": "frontline-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Archival reference site for Girls' Frontline 1: autobattle farming efficiency and T-Doll data.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:maps": "python scripts/build-maps.py",
    "data:dolls": "node scripts/fetch-dolls.mjs",
    "data:skills": "node scripts/fetch-skills.mjs",
    "data:verify": "node scripts/verify-formulas.ts",
    "check:echelon": "node scripts/check-echelon.ts",
    "check:presets": "node scripts/check-presets.ts",
    "check:skills": "node scripts/check-skills.ts",
    "verify:dolls": "node scripts/verify-dolls.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "check:render": "node scripts/render-check.mjs",
    "check": "npm run typecheck && npm run data:verify && npm run check:echelon && npm run check:presets && npm run check:skills && npm run check:render",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
